# FastAPI backend
DATABASE_URL=postgresql+asyncpg://frauduser:fraudpass@localhost:5432/frauddb
REDIS_URL=redis://localhost:6379/0
ALLOWED_ORIGINS=http://localhost:8501,http://127.0.0.1:8501,http://localhost:3000,http://127.0.0.1:3000,https://fraudguardpro.streamlit.app
SECRET_KEY=change-me-to-something-secure
ENV=development

# Optional local defaults for compose overrides
POSTGRES_DB=frauddb
POSTGRES_USER=frauduser
POSTGRES_PASSWORD=fraudpass
